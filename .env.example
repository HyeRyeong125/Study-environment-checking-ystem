# Flask Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000

# Arduino Configuration
ARDUINO_SERIAL_PORT=/dev/cu.usbserial-140
ARDUINO_BAUD_RATE=9600

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/ecomind
MONGODB_URI=mongodb://localhost:27017

# EXAONE AI Configuration
EXAONE_API_KEY=your_exaone_api_key
EXAONE_MODEL=LG-EXAONE
